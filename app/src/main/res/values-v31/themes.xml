<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ 的启动画面（系统强制显示，正好用品牌色 + 图标，
         免得从白屏突然跳到深色界面） -->
    <style name="Theme.MdViewer" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:windowSplashScreenBackground">#0757B8</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
    </style>
</resources>
